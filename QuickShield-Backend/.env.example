# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Go to: https://supabase.com → New project → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ─── Upstash Redis ────────────────────────────────────────────────────────────
# Go to: https://console.upstash.com → Create database → Copy REST URL + Token
UPSTASH_REDIS_URL=rediss://YOUR_UPSTASH_REDIS_URL
UPSTASH_REDIS_TOKEN=YOUR_UPSTASH_TOKEN

# ─── ML Service ───────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ─── Disruption Thresholds ────────────────────────────────────────────────────
RISK_HIGH_THRESHOLD=70
RISK_MEDIUM_THRESHOLD=40
PAYOUT_FLOOR_RATIO=0.667
